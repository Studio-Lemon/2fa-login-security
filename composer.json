{
  "name": "studio-lemon/2fa-login-security",
  "description": "Composer setup for 2FA Login Security tooling",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "require": {},
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "rector/rector": "^1.2",
    "squizlabs/php_codesniffer": "^3.11",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "scripts": {
    "phpcs": "vendor/bin/phpcs --standard=phpcs.xml.dist --extensions=php --colors -s -p -v ./",
    "phpcbf": "vendor/bin/phpcbf --standard=phpcs.xml.dist --extensions=php --colors -s -p -v ./",
    "rector": "vendor/bin/rector process",
    "rector:dry-run": "vendor/bin/rector process --dry-run"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": false
    }
  }
}
