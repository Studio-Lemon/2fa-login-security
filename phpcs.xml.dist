<?xml version="1.0"?>
<ruleset>
	<file>.</file>

	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/.webpack-cache/*</exclude-pattern>
	<exclude-pattern>*/css/*</exclude-pattern>
	<exclude-pattern>*/js/*</exclude-pattern>
	<exclude-pattern>*/languages/*</exclude-pattern>
	<exclude-pattern>*/img/*</exclude-pattern>
	<exclude-pattern>*/font/*</exclude-pattern>
	<exclude-pattern>*/src/*</exclude-pattern>

	<arg name="basepath" value="." />
	<arg name="colors" />

	<config name="testVersion" value="8.1-" />
	<config name="minimum_supported_wp_version" value="4.7" />

	<rule ref="Squiz.Commenting.FileComment.SpacingAfterOpen">
		<exclude-pattern>*.php</exclude-pattern>
	</rule>
	<rule ref="WordPress-Core" />
	<rule ref="WordPress-Docs" />
	<rule ref="WordPress-Extra" />

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="2fa-login-security" />
			</property>
		</properties>
	</rule>

	<rule ref="PHPCompatibilityWP" />
</ruleset>