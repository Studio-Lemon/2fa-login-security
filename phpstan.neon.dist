parameters:
	level: 5
	phpVersion: 80100

	paths:
		- 2fa-login-security.php
		- classes
		- views

	excludePaths:
		analyseAndScan:
			- vendor/*
			- node_modules/*
			- .webpack-cache/*
			- src/*
			- css/*
			- js/*
			- languages/*
			- img/*
			- font/*

	bootstrapFiles:
		- phpstan-bootstrap.php

	treatPhpDocTypesAsCertain: false
	reportUnmatchedIgnoredErrors: false

	ignoreErrors:
		# Views receive their variables through extract() in classes/model/view.php.
		-
			identifier: variable.undefined
			path: views/*
		# wp_send_json() is stubbed as never-returning, but wp_die() can be
		# short-circuited by a filter, so the trailing die() is a real guard.
		-
			identifier: deadCode.unreachable
			path: classes/controller/ajax.php
			count: 1
