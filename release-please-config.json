{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "php",
  "initial-version": "2.0.0",
  "changelog-sections": [
    { "type": "feat", "section": "⛰️ Features" },
    { "type": "fix", "section": "🐛 Bug Fixes" },
    { "type": "bug", "section": "🐛 Bug Fixes" },
    { "type": "refactor", "section": "🚜 Refactor" },
    { "type": "enhance", "section": "⚡ Enhancements" },
    { "type": "enhancement", "section": "⚡ Enhancements" },
    { "type": "docs", "section": "📚 Documentation" },
    { "type": "doc", "section": "📚 Documentation" },
    { "type": "style", "section": "🎨 Styling" },
    { "type": "scss", "section": "🎨 Styling" },
    { "type": "test", "section": "🧪 Testing" },
    { "type": "tests", "section": "🧪 Testing" },
    { "type": "deprecate", "section": "🪦 Deprecate" },
    { "type": "chore", "section": "⚙️ Miscellaneous Tasks" },
    { "type": "ci", "section": "⚙️ Miscellaneous Tasks" },
    { "type": "security", "section": "🛡️ Security" },
    { "type": "revert", "section": "◀️ Revert" }
  ],
  "include-component-in-tag": false,
  "include-v-in-tag": false,
  "include-v-in-release-name": false,
  "packages": {
    ".": {
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "generic", "path": "2fa-login-security.php" },
        { "type": "json", "path": "package.json", "jsonpath": "$.version" },
        { "type": "generic", "path": "readme.txt" }
      ]
    }
  }
}
